MODEL_DIR=./model/model
DATA_DIR=./data
AUTOTOM_PORT=8080
# Linux host ownership for bind-mounted files
LOCAL_UID=1000
LOCAL_GID=1000
GPU_DEVICE=0
JAVA_HEAP=6g
# Optional public server profile. Generate the password hash with:
# docker run --rm caddy:2.10-alpine caddy hash-password
AUTOTOM_DOMAIN=tomato.example.com
AUTH_USER=autotom
# Put the bcrypt hash in single quotes in this .env file.
AUTH_PASSWORD_HASH=
